{
  "name": "avia-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "husky": "^9.1.7",
    "typescript": "~5.9.3",
    "validate-branch-name": "^1.3.2",
    "vite": "^7.2.4"
  },
  "validate-branch-name": {
    "pattern": "^(feat|fix|chore|docs|style|refactor)/[a-z0-9-]+$",
    "errorMsg": "Branch name '{branchName}' does not follow the pattern 'type/short-description'. Example: 'feat/add-login-button'"
  }
}
